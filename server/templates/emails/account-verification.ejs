<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verify your Thriftify account</title>
  </head>
  <body style="margin:0;padding:32px 16px;background:#f4f1f7;font-family:Arial,Helvetica,sans-serif;color:#211b26;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;">
      <tr>
        <td style="padding:28px 32px;background:#25012b;color:#ffffff;">
          <p style="margin:0;font-size:13px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;">Thriftify</p>
        </td>
      </tr>
      <tr>
        <td style="padding:36px 32px 20px;">
          <p style="margin:0 0 10px;color:#8a1db6;font-size:13px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Welcome</p>
          <h1 style="margin:0 0 16px;font-size:26px;line-height:1.3;">Verify your email address</h1>
          <p style="margin:0;color:#625b66;font-size:15px;line-height:1.7;">Use this code to finish creating your Thriftify account.</p>
        </td>
      </tr>
      <tr>
        <td style="padding:8px 32px 24px;">
          <div style="padding:20px;background:#f7f1fa;border:1px solid #eadcf0;border-radius:12px;text-align:center;">
            <p style="margin:0 0 8px;color:#625b66;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Your verification code</p>
            <p style="margin:0;color:#25012b;font-family:Arial,Helvetica,sans-serif;font-size:34px;font-weight:bold;letter-spacing:8px;"><%= code %></p>
          </div>
        </td>
      </tr>
      <tr>
        <td style="padding:0 32px 32px;">
          <p style="margin:0;color:#625b66;font-size:14px;line-height:1.7;">This code expires in 10 minutes. If you did not request a Thriftify account, you can ignore this email.</p>
        </td>
      </tr>
      <tr>
        <td style="padding:18px 32px;background:#faf9fb;color:#8a8490;font-size:12px;">© Thriftify</td>
      </tr>
    </table>
  </body>
</html>
